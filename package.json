{
  "name": "aws-xray-example",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:docs": "pnpm --filter docs start",
    "sam:build": "sam build -t infrastructure/template.yaml",
    "sam:deploy": "sam deploy --no-fail-on-empty-changeset",
    "deploy:frontend": "bash scripts/deploy-frontend.sh",
    "deploy:ec2": "bash scripts/deploy-ec2.sh",
    "deploy": "pnpm sam:build && pnpm sam:deploy && pnpm deploy:frontend && pnpm deploy:ec2"
  }
}
